/target
/tools/golden-gen/.venv
__pycache__/
# wasm-pack outputs — build artifacts, regenerated by CI and the size script.
# The glob covers `pkg-node` / `pkg-size` (ci.yml, tools/wasm-size-table.sh)
# AND release.yml's `pkg-<preset>-<target>` fan-out, which is five presets x
# three targets and used to land untracked in a release-rehearsal working tree.
/crates/rustprop-wasm/pkg
/crates/rustprop-wasm/pkg-*
# release.yml packages its artifacts at the repo root before uploading them.
/rustprop-wasm-*.tar.gz
/rustprop-cli-*.tar.gz
