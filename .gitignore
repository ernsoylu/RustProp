/target
/tools/golden-gen/.venv
__pycache__/
# wasm-pack outputs — build artifacts, regenerated by CI and the size script.
# The glob covers `pkg-node` / `pkg-size` (ci.yml, tools/wasm-size-table.sh)
# AND release.yml's `pkg-<preset>-<target>` fan-out, which is five presets x
# three targets and used to land untracked in a release-rehearsal working tree.
/crates/rustprop-wasm/pkg
/crates/rustprop-wasm/pkg-*
# release.yml packages its artifacts at the repo root before uploading them.
/rustprop-wasm-*.tar.gz
/rustprop-cli-*.tar.gz
/rustprop-*-rust-sources*
# The native SDK staging directory (crates/rustprop-capi/package.sh writes
# here, and both ci.yml and release.yml package into it) and its tarballs.
/dist
/rustprop-0*.tar.gz
# gfortran writes a .mod beside wherever it is invoked when it compiles the
# Fortran binding example (crates/rustprop-capi/examples/bindings/rustprop.f90).
*.mod
# Alternate target dirs used when comparing -C target-cpu baselines, so the
# four builds do not invalidate each other's cache. See PLAN.md's R11 entry.
/target-*
